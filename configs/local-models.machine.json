{
  "wsl_distribution": "Ubuntu",
  "python": "/home/hectum/.cache/jev-research-env/bin/python",
  "models": {
    "gliguard": {
      "key": "gliguard",
      "weights": "local-models/nov04/restored/gliguard",
      "script": "scripts/local_gliguard_server.py",
      "args": [
        "--model-path",
        "{weights}",
        "--served-name",
        "gliguard-300m",
        "--port",
        "8001"
      ],
      "port": 8001,
      "route": "/classify",
      "model_id": "gliguard-300m"
    },
    "laya": {
      "key": "laya",
      "weights": "local-models/nov04/restored/laya",
      "script": "scripts/local_laya_server.py",
      "args": [
        "--model-path",
        "{weights}",
        "--served-name",
        "laya-421m",
        "--device",
        "cuda",
        "--port",
        "8002"
      ],
      "port": 8002,
      "route": "/v1/systemone",
      "model_id": "laya-421m",
      "environment": {
        "LAYA_CUDA_AMP": "fp32"
      }
    },
